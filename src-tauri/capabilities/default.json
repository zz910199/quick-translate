{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window access to window controls and app events",
  "windows": ["main", "screenshot-*"],
  "permissions": [
    "core:window:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to"
  ]
}
