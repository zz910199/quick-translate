{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quick Translate",
  "version": "0.1.0",
  "identifier": "com.quicktranslate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "D:/QuickTranslate/Data",
    "windows": [
      {
        "label": "main",
        "title": "Quick Translate",
        "dataDirectory": "D:/QuickTranslate/Data/WebView",
        "width": 640,
        "height": 440,
        "minWidth": 360,
        "minHeight": 300
      }
    ]
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Personal screenshot OCR and quick translation",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
