{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quick Translate",
  "version": "0.1.0",
  "identifier": "com.quicktranslate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quick Translate",
        "width": 640,
        "height": 440,
        "minWidth": 360,
        "minHeight": 300
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
